# Configuration Supabase - TVRS Maps
# Renomme ce fichier en ".env" et remplace les valeurs par celles de ton projet Supabase.

# L'URL de ton projet Supabase (ex: https://abcde12345.supabase.co)
VITE_SUPABASE_URL=YOUR_SUPABASE_URL

# La clé publique anonyme (Anon Key) de ton projet Supabase
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
